# Configuración NO sensible del entorno local.
# `python scripts/dev.py setup` copia este archivo a .env si no existe.
# Las contraseñas y llaves NO van aquí: viven en secrets/ y se montan como Docker secrets.

# development habilita /api/docs y /api/openapi.json (necesarios para ZAP). Cualquier otro valor los apaga.
APP_ENV=development

# Puerto publicado SOLO en 127.0.0.1 (no expuesto a la red local). Cámbialo si el 8080 está ocupado.
HTTP_PORT=8080

# Subred de la red "edge" (proxy <-> backend). El backend solo confía en X-Forwarded-* que vengan de aquí.
EDGE_SUBNET=172.30.10.0/24
